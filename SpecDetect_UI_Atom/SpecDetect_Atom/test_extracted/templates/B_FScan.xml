<srrc:responsebody><srrc:result>
    <srrc:appid>{appid}</srrc:appid>
    <srrc:userid>{userid}</srrc:userid>
    <srrc:priority>{priority}</srrc:priority>
    <srrc:executetime>{executetime}</srrc:executetime>
    <srrc:mfid>{mfid}</srrc:mfid>
    <srrc:equid>{equid}</srrc:equid>
    <srrc:taskid>{taskid}</srrc:taskid>
    <srrc:equpara>
        <srrc:groupitems>
            <srrc:groupitem>
                <srrc:groupid>1</srrc:groupid>
                <srrc:items>
                    <srrc:item><srrc:paraname>startfreq</srrc:paraname><srrc:paravalue>{startfreq}</srrc:paravalue></srrc:item>
                    <srrc:item><srrc:paraname>stopfreq</srrc:paraname><srrc:paravalue>{stopfreq}</srrc:paravalue></srrc:item>
                    <srrc:item><srrc:paraname>step</srrc:paraname><srrc:paravalue>{step}</srrc:paravalue></srrc:item>
                    <srrc:item><srrc:paraname>gain</srrc:paraname><srrc:paravalue>{gain}</srrc:paravalue></srrc:item>
                    <srrc:item><srrc:paraname>rfworkmode</srrc:paraname><srrc:paravalue>0</srrc:paravalue></srrc:item>
                    <srrc:item><srrc:paraname>scanmode</srrc:paraname><srrc:paravalue>{scanmode}</srrc:paravalue></srrc:item>
                </srrc:items>
            </srrc:groupitem>
        </srrc:groupitems>
    </srrc:equpara>
    <srrc:outputchannel>
        <srrc:mode>{outputchannel_mode}</srrc:mode>
        <srrc:datachannel>{outputchannel_datachannel}</srrc:datachannel>
        <srrc:host>{outputchannel_host}</srrc:host>
        <srrc:port>{outputchannel_port}</srrc:port>
        <srrc:stc>{outputchannel_stc}</srrc:stc>
    </srrc:outputchannel>
</srrc:result></srrc:responsebody>
