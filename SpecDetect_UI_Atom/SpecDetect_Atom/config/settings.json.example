{
  // ========== XML配置 ==========
  // 是否从legacy XML读取配置
  "use_legacy_xml": true,
  // legacy XML配置文件路径，相对于config目录
  "legacy_xml_path": "legacy/atomsvcconfig.xml",

  // ========== Atom服务 ==========
  "atom": {
    // Atom服务监听地址
    "host": "127.0.0.1",
    // SOAP服务端口
    "soap_port": 8282,
    // streamsrc服务监听地址
    "streamsrc_ip": "127.0.0.1",
    // streamsrc服务端口，客户端连接此端口获取频谱数据
    "streamsrc_port": 18012,
    // 原子协议类型
    "protocol": "boer"
  },

  // ========== 设备配置 ==========
  "device": {
    // 设备RMCP服务地址
    "host": "100.72.95.36",
    // 设备RMCP服务端口
    "port": 1449
  },

  // ========== 会话配置 ==========
  "session": {
    // 无连接session超时时间（秒）
    "stale_timeout": 30,
    // session空闲超时时间（秒）
    "idle_timeout": 30,
    // 最大并发session数量
    "max_sessions": 5,
    // 设备状态上报间隔（秒）
    "put_time_interval": 60,
    // 是否通过最大任务数判断设备忙碌
    "judge_busy_by_max_task_num": false
  },

  // ========== 日志配置 ==========
  "log": {
    // 日志级别：DEBUG/INFO/WARNING/ERROR
    "level": "INFO",
    // 日志文件目录
    "dir": "./logs",
    // 各日志级别开关
    "debug": true,
    "info": true,
    "warning": true,
    "error": true
  }
}
